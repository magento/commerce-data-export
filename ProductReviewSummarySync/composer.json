{
    "name": "adobe-commerce/module-product-review-summary-sync",
    "description": "Exports native Magento product review summaries to the ac_review_count and ac_rating_summary product attributes and keeps them in sync",
    "type": "magento2-module",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "AdobeCommerce\\ProductReviewSummarySync\\": ""
        }
    },
    "require": {
        "php": ">=8.1.0",
        "magento/framework": ">=103.0.4",
        "magento/module-catalog": ">=104.0.4",
        "magento/module-review": ">=100.4.4",
        "magento/module-store": ">=101.1.4",
        "magento/module-data-exporter": "self.version",
        "adobe-commerce/module-product-review-summary-attributes": "self.version"
    }
}
