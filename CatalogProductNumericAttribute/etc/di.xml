<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Map frontend_input "numeric" to backend_type "decimal" and default value field -->
    <type name="Magento\Eav\Model\Entity\Attribute">
        <plugin name="catalog_product_numeric_attribute_backend_type"
                type="AdobeCommerce\CatalogProductNumericAttribute\Plugin\Eav\Model\Entity\AttributePlugin"/>
    </type>
    <!-- Ensure "numeric" passes input-type validation on attribute save -->
    <type name="Magento\Eav\Helper\Data">
        <plugin name="catalog_product_numeric_attribute_input_types"
                type="AdobeCommerce\CatalogProductNumericAttribute\Plugin\Eav\Helper\DataPlugin"/>
    </type>
    <!-- Allow "numeric" attributes in catalog price rule conditions -->
    <type name="Magento\Catalog\Model\ResourceModel\Eav\Attribute">
        <plugin name="catalog_product_numeric_attribute_rule_condition"
                type="AdobeCommerce\CatalogProductNumericAttribute\Plugin\Catalog\Model\ResourceModel\Eav\AttributePlugin"/>
    </type>
    <!-- Map "numeric" to FilterRangeTypeInput in GraphQL product filter config -->
    <type name="Magento\CatalogGraphQl\Model\Config\FilterAttributeReader">
        <plugin name="catalog_product_numeric_attribute_graphql_filter"
                type="AdobeCommerce\CatalogProductNumericAttribute\Plugin\CatalogGraphQl\Model\Config\FilterAttributeReaderPlugin"/>
    </type>
    <!-- Add validate-number rule for numeric input so non-numeric values are rejected in admin -->
    <type name="Magento\Catalog\Ui\DataProvider\CatalogEavValidationRules">
        <plugin name="catalog_product_numeric_attribute_validation_rules"
                type="AdobeCommerce\CatalogProductNumericAttribute\Plugin\Catalog\Ui\DataProvider\CatalogEavValidationRulesPlugin"/>
    </type>
    <!-- Include "numeric" in SaaS feed NumericMetadataFormatter so attributes get numeric:true flag -->
    <virtualType name="Magento\CatalogDataExporter\Model\Provider\Product\Formatter\NumericMetadataFormatter"
                 type="Magento\CatalogDataExporter\Model\Provider\Product\Formatter\BooleanNumericMetadataFormatter">
        <arguments>
            <argument name="frontendInput" xsi:type="array">
                <item name="numeric" xsi:type="string">numeric</item>
            </argument>
        </arguments>
    </virtualType>
    <!-- Map frontend_input "numeric" to the standard HTML input form element in admin -->
    <type name="Magento\Ui\DataProvider\Mapper\FormElement">
        <arguments>
            <argument name="mappings" xsi:type="array">
                <item name="numeric" xsi:type="string">input</item>
            </argument>
        </arguments>
    </type>
    <!-- Add "Number" to the EAV input type dropdown in admin attribute management -->
    <type name="Magento\Eav\Model\Adminhtml\System\Config\Source\Inputtype">
        <arguments>
            <argument name="optionsArray" xsi:type="array">
                <item name="800" xsi:type="array">
                    <item name="value" xsi:type="string">numeric</item>
                    <item name="label" xsi:type="string" translate="true">Number</item>
                </item>
            </argument>
        </arguments>
    </type>
    <!-- Admin product grid: from/to range filter for Number attributes (Listing\Columns defaults to text) -->
    <type name="Magento\Catalog\Ui\Component\ColumnFactory">
        <plugin name="catalog_product_numeric_attribute_grid_filter_range"
                type="AdobeCommerce\CatalogProductNumericAttribute\Plugin\Ui\Component\ColumnFactoryPlugin"/>
    </type>
</config>
