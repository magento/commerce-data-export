<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <ac_disabled_indexers>
            <!--
                The write-side category data this module reads can replace these indexers when a
                catalog is exported to ACO/CCDM. They are managed by AdobeCommerce_IndexerStatusManager
                but ship enabled (0) by default; set to 1 (or run bin/magento indexer:disable) to turn
                them off.
            -->
            <catalog_category_product>0</catalog_category_product>
            <catalog_product_category>0</catalog_product_category>
        </ac_disabled_indexers>
    </default>
</config>
