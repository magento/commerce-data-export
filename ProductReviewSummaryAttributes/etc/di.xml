<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Disabled by default: review provider modules override this preference to export review summaries -->
    <preference for="AdobeCommerce\ProductReviewSummaryAttributes\Api\ReviewSummarySourceInterface"
                type="AdobeCommerce\ProductReviewSummaryAttributes\Model\Source\DisabledReviewSummarySource"/>

    <type name="Magento\DataExporter\Export\Processor">
        <plugin name="product_review_summary_attributes_add_to_product_feed"
                type="AdobeCommerce\ProductReviewSummaryAttributes\Plugin\AddReviewAttributesToProductFeed"/>
    </type>

    <!--
        Not registered in the shared Magento\CatalogDataExporter\Service\SystemAttributeRegistrar configurationMap:
        those attributes are created for every merchant, while these ones are created only when review summaries
        are exported.
    -->
    <type name="AdobeCommerce\ProductReviewSummaryAttributes\Model\ReviewSummaryAttributeRegistry">
        <arguments>
            <argument name="configurationMap" xsi:type="array">
                <item name="ac_review_count" xsi:type="array">
                    <item name="properties" xsi:type="array">
                        <item name="label" xsi:type="string">Review Count</item>
                        <item name="note" xsi:type="string">Number of approved reviews. Generated by the system from product reviews.</item>
                        <item name="type" xsi:type="string">decimal</item>
                        <item name="input" xsi:type="string">numeric</item>
                        <!-- Listed in Stores > Attributes > Product; removed from the product form in adminhtml/di.xml -->
                        <item name="visible" xsi:type="boolean">true</item>
                        <item name="visible_on_front" xsi:type="boolean">false</item>
                        <item name="used_in_product_listing" xsi:type="boolean">false</item>
                        <item name="used_for_sort_by" xsi:type="boolean">false</item>
                        <item name="filterable_in_search" xsi:type="boolean">false</item>
                    </item>
                    <item name="exporterOverrides" xsi:type="array">
                        <!-- PDP role is always on; PLP, search, sort and filter are configured by the merchant -->
                        <item name="visible" xsi:type="boolean">true</item>
                    </item>
                </item>
                <item name="ac_rating_summary" xsi:type="array">
                    <item name="properties" xsi:type="array">
                        <item name="label" xsi:type="string">Average Rating %</item>
                        <item name="note" xsi:type="string">Average rating as a percentage (0-100). Generated by the system from product reviews.</item>
                        <item name="type" xsi:type="string">decimal</item>
                        <item name="input" xsi:type="string">numeric</item>
                        <!-- Listed in Stores > Attributes > Product; removed from the product form in adminhtml/di.xml -->
                        <item name="visible" xsi:type="boolean">true</item>
                        <item name="visible_on_front" xsi:type="boolean">false</item>
                        <item name="used_in_product_listing" xsi:type="boolean">false</item>
                        <item name="used_for_sort_by" xsi:type="boolean">false</item>
                        <item name="filterable_in_search" xsi:type="boolean">false</item>
                    </item>
                    <item name="exporterOverrides" xsi:type="array">
                        <!-- PDP role is always on; PLP, search, sort and filter are configured by the merchant -->
                        <item name="visible" xsi:type="boolean">true</item>
                    </item>
                </item>
            </argument>
        </arguments>
    </type>
</config>
